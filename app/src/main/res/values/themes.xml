<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.FixTok" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/fixtok_background</item>
        <item name="android:colorBackground">@color/fixtok_background</item>
        <item name="android:statusBarColor">@color/fixtok_background</item>
        <item name="android:navigationBarColor">@color/fixtok_background</item>
    </style>

    <style name="Theme.FixTok.Fullscreen" parent="Theme.FixTok">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="FixTok.MenuButton" parent="Widget.AppCompat.Button">
        <item name="android:textColor">@color/fixtok_text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

</resources>
